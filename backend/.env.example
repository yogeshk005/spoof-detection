APP_NAME=BlinkCheck API
ENVIRONMENT=development
MOCK_MODE=true
DATABASE_URL=sqlite:///./blinkcheck.db
AWS_REGION=us-east-1
S3_BUCKET=
SES_FROM_EMAIL=
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_SECONDS=180
OTP_SECRET=change-this-to-a-long-random-secret
OTP_TTL_SECONDS=60
MAX_SCORED_ATTEMPTS=3
ATTEMPT_WINDOW_SECONDS=900
LOCKOUT_SECONDS=900
