{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Effect":  "Allow",
                          "Principal":  {
                                            "Federated":  "cognito-identity.amazonaws.com"
                                        },
                          "Condition":  {
                                            "ForAnyValue:StringLike":  {
                                                                           "cognito-identity.amazonaws.com:amr":  "unauthenticated"
                                                                       },
                                            "StringEquals":  {
                                                                 "cognito-identity.amazonaws.com:aud":  "us-east-1:70d97019-4e7a-4b5a-ac33-d4f84798a794"
                                                             }
                                        },
                          "Action":  "sts:AssumeRoleWithWebIdentity"
                      }
                  ]
}